# ---------------------------------------------------------------------------
# invoice-iq environment configuration
# Copy to `.env` and fill in. `.env` is gitignored — NEVER commit real secrets.
# Every variable below is documented; unused ones are safe to leave as-is.
# ---------------------------------------------------------------------------

# --- Provider selection (local-first defaults) -----------------------------
# Toggles between local implementations and GCP swap-ins (added in Phase 7).
# Valid values: "local" | "gcp"
OCR_PROVIDER=local
EMBEDDING_PROVIDER=local
VECTOR_STORE=local
CLASSIFIER_BACKEND=local        # "local" (PyTorch checkpoint) | "vertex" (endpoint)

# --- Optional LLM extraction path (Phase 2) --------------------------------
# Rule-based extraction is the always-on default; tests never need this key.
# Set ENABLE_LLM_EXTRACTION=true AND provide a key to enable the LLM path.
ENABLE_LLM_EXTRACTION=false
ANTHROPIC_API_KEY=

# --- GCP / Vertex AI (Phase 7 only — leave blank until then) ---------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=          # path to service-account JSON (gitignored)
VERTEX_CLASSIFIER_ENDPOINT_ID=
DOCAI_PROCESSOR_ID=

# --- Serving (Phase 6) -----------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- Storage paths (local) -------------------------------------------------
MODEL_DIR=models
CHROMA_DIR=chroma
DATA_DIR=data
